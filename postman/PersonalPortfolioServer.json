                  "// Ensure request returned 200/201 and has response data",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.body;",
                  "",
                  "    // Adjust paths if your API response nesting differs:",
                  "    // If tokens are nested inside data.tokens (from your previous Signup endpoint):",
                  "    const accessToken = data.access || (data.tokens && data.tokens.access);",
                  "    const refreshToken = data.refresh || (data.tokens && data.tokens.refresh);",
                  "",
                  "    if (accessToken) {",
                  "        pm.environment.set(\"access_token\", accessToken);",
                  "    }",
                  "    ",
                  "    if (refreshToken) {",
                  "        pm.environment.set(\"refresh_token\", refreshToken);",
                  "    }",
